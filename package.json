{
  "name": "post-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multiicon Post Studio: plan, generate, approve and publish social posts with Claude and image models.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fal-ai/client": "^1.10.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@google/genai": "^2.32.0",
    "archiver": "^8.0.0",
    "fastify": "^5.12.7",
    "openai": "^7.47.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
