# Copy to .env and fill in what you have. Anything left empty switches that feature off.
# Never commit .env. On the server, keep it readable by root only (chmod 600).

# --- Required ---
APP_PASSWORD=change-me-to-a-long-team-password
SESSION_SECRET=change-me-to-32-random-characters-or-more
POSTGRES_PASSWORD=change-me-db-password
# The address people (and Instagram) use to reach this server. Must be HTTPS for Instagram.
PUBLIC_BASE_URL=https://social.example.com
APP_PORT=8080
TIMEZONE=Asia/Kolkata

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MODEL_QUICK=claude-opus-5-5

# --- Image models (any one is enough to start; fal.ai covers FLUX, Ideogram and Kling) ---
FAL_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_IMAGE_PROVIDER=flux
# FAL_FLUX_MODEL=fal-ai/flux-pro/v1.1-ultra
# FAL_FLUX_EDIT_MODEL=fal-ai/flux-pro/kontext
# FAL_IDEOGRAM_MODEL=fal-ai/ideogram/v3
# FAL_KLING_IMAGE_MODEL=fal-ai/kling-image/v2
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Instagram (Meta developer app, Instagram API with Instagram Login) ---
# Leave empty until the test account works. IG_PUBLISH_ENABLED=true is the final switch.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v25.0
IG_PUBLISH_ENABLED=false
